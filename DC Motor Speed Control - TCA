#include <LiquidCrystal_I2C.h>
// Include LCD display Library

LiquidCrystal_I2C lcd(0x27, 16, 2);
// Configure LCD with the address, columns and rows

const int motorPin = 9;
//map the motor to pin 9
const int potPin = A0;
//map the potentiometer to pin A0

void setup() {
  lcd.init();
  lcd.backlight();
  //Turn on the LCD Pannel
  pinMode(motorPin, OUTPUT);
  //Set the motor to an output device
}

void loop() {
  int potValue = analogRead(potPin);
  //Read the voltage level of the potentiometer as a digital value
  int speed = map(potValue, 0, 1023, 0, 255);
  //Map the potentiometer voltage to the PWM range
  analogWrite(motorPin, speed);
  //ouput the PWM amount set by the pot to the motor
  
  float rpm = speed * (9962.0 / 255.0);
  //calculate the RPM using the max RPM/max PWM * current speed
  lcd.setCursor(0, 0);
  lcd.print("RPM:");
  //Print RPM message to display
  lcd.setCursor(0, 1);
  lcd.print(rpm, 1);
  lcd.print("     ");
  // Print the current RPM to display
  delay(10);
  //Repeat every 0.01s
}
